# URL do WordPress (backend headless)
# Ex local: http://localhost:8080
# Ex produção: https://seu-wp-dominio.com
NEXT_PUBLIC_WORDPRESS_URL=

# Endpoint GraphQL do WPGraphQL
# Ex local: http://localhost:8080/graphql
# Ex produção: https://seu-wp-dominio.com/graphql
NEXT_PUBLIC_GRAPHQL_ENDPOINT=

# URL pública do site Next.js (frontend)
NEXT_PUBLIC_SITE_URL=

# Habilite somente se o schema WPGraphQL tiver o post type `evento` (campo `eventos`)
NEXT_PUBLIC_ENABLE_EVENTOS=false

# Chave secreta do plugin FaustWP (Settings → Faust no WordPress)
FAUST_SECRET_KEY=

# URL de gatilho de implantação no EasePanel
DEPLOY_WEBHOOK_URL=